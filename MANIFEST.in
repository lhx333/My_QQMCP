include LICENSE README.md CHANGELOG.md requirements.txt run_mcp.py
recursive-include llonebot_mcp *.py *.toml *.md *.txt
recursive-include docs *.md
recursive-include tests *.py
include .github/workflows/omniqq-ci.yml
global-exclude *.pyc *.log
prune llonebot_mcp/build
prune llonebot_mcp/__pycache__
prune llonebot_mcp/tools/__pycache__
